# Required for Gemini AI style direction. If empty, the local couture engine is used.
GEMINI_API_KEY=

# Public URL of this app (https://your-domain.com). Used for self-referential links.
APP_URL=

# HTTP port. Most hosts inject PORT automatically.
PORT=3000

# Bind address. Keep 0.0.0.0 on a VPS / Docker.
HOST=0.0.0.0

# Optional custom folder for consultations.json (local / VPS only; not durable on Vercel).
# DATA_DIR=/var/lib/margo-atelier

# Telegram Bot Token from @BotFather for consultation notifications.
TELEGRAM_BOT_TOKEN=

# Telegram chat or channel ID where dossiers are delivered.
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta) — deliver dossiers to MARGO Business without opening wa.me.
# Create at https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# E.164 digits only, no +. Default: MARGO business number.
WHATSAPP_NOTIFY_TO=393498124490

# Inbox that receives a copy of every consultation dossier.
ADMIN_EMAIL=hello@margoatelier.co.za

# SMTP for dossier emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=hello@margoatelier.co.za
# SMTP_PASS=
# SMTP_FROM=MARGO Atelier <hello@margoatelier.co.za>

# Password for Atelier admin console (required to view / update dossiers).
ADMIN_PASSWORD=margo-admin
